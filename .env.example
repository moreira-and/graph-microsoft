# Create an app registration in a dedicated Microsoft Entra test tenant.
# Never commit real credentials; copy this file to the ignored .env file.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# SharePoint site identifier used by the integration tests.
SHAREPOINT_SITE_ID=

# Microsoft Graph application token scope.
GRAPH_SCOPE=https://graph.microsoft.com/.default

# Grant only the Sites.Selected application permission and explicitly grant
# read access to the test site. Admin consent and a site-level grant are required.
# https://learn.microsoft.com/en-us/graph/permissions-selected-overview
